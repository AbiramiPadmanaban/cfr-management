generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id               String     @id @default(uuid())
  departmentId     String
  projectName      String
  projectNumber    String
  clientName       String
  projectStartDate DateTime
  projectEndDate   DateTime
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  cfrs             Cfr[]
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, projectName])
}

model Cfr {
  id                    Int       @id @default(autoincrement())
  projectId             String
  reviewPeriod          String
  qualityRating                Float?
  deliveryRating               Float?
  communicationRating          Float?
  technicalCompetence          Float?
  overallSatisfaction          Float?
  qualityRemarks               String?
  deliveryRemarks              String?
  communicationRemarks         String?
  technicalCompetenceRemarks   String?
  overallSatisfactionRemarks   String?
  comments                     String?
  reviewedBy                   String?
  reviewedAt                   DateTime?
  actionNeeded                 Boolean?
  status                CfrStatus @default(DRAFT)
  client                String
  projectNumber         String
  clientEmail           String
  documentNo            String?
  revNo                 String?
  revDate               DateTime?
  feedbackToken         String?   @unique
  feedbackSentAt        DateTime?
  feedbackSubmittedAt   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notifications         Notification[]
}

model Notification {
  id        String    @id @default(uuid())
  cfrId     Int
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  cfr       Cfr       @relation(fields: [cfrId], references: [id], onDelete: Cascade)
}

enum CfrStatus {
  DRAFT
  SENT
  SUBMITTED
}

enum UserRole {
  ADMIN
  USER
}

enum AuthTokenType {
  PASSWORD_SETUP
  PASSWORD_RESET
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  name           String?
  passwordHash   String?
  passwordSetAt  DateTime?
  isActive       Boolean     @default(true)
  role           UserRole    @default(USER)
  sessionVersion Int         @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tokens         AuthToken[]
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}
