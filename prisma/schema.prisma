generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id               String     @id @default(uuid())
  departmentId     String
  projectName      String
  projectNumber    String
  clientName       String
  projectStartDate DateTime
  projectEndDate   DateTime
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  cfrs             Cfr[]
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, projectName])
}

model Cfr {
  id                  Int       @id @default(autoincrement())
  projectId           String
  reviewPeriod        String
  qualityRating       Float
  deliveryRating      Float
  communicationRating Float
  technicalCompetence Float
  overallSatisfaction Float
  comments            String?
  status              CfrStatus @default(DRAFT)
  client              String
  projectNumber       String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum CfrStatus {
  DRAFT
  SENT
  SUBMITTED
}
